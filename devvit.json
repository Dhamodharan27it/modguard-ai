{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "modguard-ai",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "⚡ Analyse with ModGuard AI",
        "description": "Analyse this post for violations using AI",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/analyse-post"
      },
      {
        "label": "⚡ Analyse with ModGuard AI",
        "description": "Analyse this comment for violations using AI",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/analyse-comment"
      },
      {
        "label": "✕ Remove Post",
        "description": "Remove this post and issue a strike",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/remove-post"
      },
      {
        "label": "✕ Remove Comment",
        "description": "Remove this comment and issue a strike",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/remove-comment"
      },
      {
        "label": "✓ Approve Post",
        "description": "Approve this post",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/approve-post"
      },
      {
        "label": "⚠ Escalate Post",
        "description": "Escalate this post for senior review",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/escalate-post"
      }
    ]
  },
  "forms": {
    "mopComment": "/internal/form/mop-comment-submit",
    "mopPost": "/internal/form/mop-post-submit"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "permissions": {
    "reddit": true
  },
  "dev": {
    "subreddit": "modguard_ai_dev"
  }
}