{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "modguard-ai",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "⚡ Analyse with ModGuard AI",
        "description": "AI auto-detects violation and takes action",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/analyse-post"
      },
      {
        "label": "⚡ Analyse with ModGuard AI",
        "description": "AI auto-detects violation and takes action",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/analyse-comment"
      },
      {
        "label": "✕ Remove Post",
        "description": "Remove and issue a strike",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/remove-post"
      },
      {
        "label": "✕ Remove Comment",
        "description": "Remove and issue a strike",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/remove-comment"
      },
      {
        "label": "✓ Approve Post",
        "description": "Approve this post",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/approve-post"
      },
      {
        "label": "⚠ Escalate Post",
        "description": "Escalate for senior review",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/escalate-post"
      },
      {
        "label": "🔍 Scan All Posts with AI",
        "description": "Bulk analyse entire subreddit queue with AI",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/scan-all"
      },
      {
        "label": "📊 Open ModGuard Dashboard",
        "description": "View full AI mod dashboard",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/open-dashboard"
      },
      {
        "label": "🚨 Check Threat Level",
        "description": "Predict incoming raids or attacks",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/predict-threat"
      },
      {
        "label": "⚡ Deep Analyse Post (v2)",
        "description": "Full AI pipeline: toxicity, hate, spam, scam, NSFW, context",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/analyse-post-v2"
      },
      {
        "label": "👁 Add to Watchlist",
        "description": "Flag this user for extra scrutiny",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/watchlist-add"
      }
    ]
  },
  "forms": {
    "mopComment": "/internal/form/mop-comment-submit",
    "mopPost": "/internal/form/mop-post-submit"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "permissions": {
    "reddit": true
  }
}