{
  "private": true,
  "name": "modguard-ai",
  "version": "0.0.1",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "npx esbuild src/index.ts --bundle --platform=node --target=es2022 --outfile=dist/server/index.js --format=cjs",
    "deploy": "npm run type-check && npm run lint && npm run test && devvit upload",
    "dev": "devvit playtest",
    "launch": "npm run deploy && devvit publish",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "test": "vitest run",
    "type-check": "tsc --build"
  },
  "engines": {
    "node": ">=22.2.0"
  },
  "dependencies": {
    "@devvit/start": "^0.12.22",
    "@devvit/web": "^0.12.22",
    "@hono/node-server": "^1.19.9",
    "devvit": "^0.12.22",
    "hono": "4.11.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "^22.19.7",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "eslint": "9.39.2",
    "globals": "17.2.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "7.3.1"
  }
}
